<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- Configurations that affect the Test Framework -->
  <RunConfiguration>
    <!-- Use 0 for maximum process-level parallelization. This does not force parallelization within
    the test DLL (on the thread-level). You can also change it from the Test menu; choose "Run tests
    in parallel". Unchecked = 1 (only 1), checked = 0 (max). -->
    <MaxCpuCount>1</MaxCpuCount>
    <!-- Path relative to directory that contains .runsettings file-->
    <ResultsDirectory>./TestResults</ResultsDirectory>
  </RunConfiguration>

  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <ExcludeByFile>
            **/*.g.cs,
            **/*.generated.cs,
            **/Migrations/**/*.cs,
            **/Configuration/PostgresConfiguration.cs,
            **/Database/DbDataSeeder.cs
          </ExcludeByFile>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <ExcludeByAttribute>**/Microsoft.AspNetCore.OpenApi.Generated/**</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

  <TestRunParameters>
    <Parameter name="DatabaseType" value="IN_MEMORY" />
  </TestRunParameters>

</RunSettings>